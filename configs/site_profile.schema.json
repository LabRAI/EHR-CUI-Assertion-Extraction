{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/LabRAI/EHR-CUI-Assertion-Extraction/configs/site_profile.schema.json",
  "title": "EHR extraction site profile",
  "type": "object",
  "required": ["schema_name", "schema_version", "assertion_scopes", "measurement_scope"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_name": {"const": "ehr_cui_assertion_site_profile"},
    "schema_version": {"const": 1},
    "adaptation_mode": {
      "enum": ["unlabeled_structural_bounded", "labeled_calibration_bounded", "site_adaptive_bounded"]
    },
    "assertion_scopes": {
      "type": "object",
      "propertyNames": {
        "enum": ["negation", "conditional", "possible", "hypothetical", "historical", "current", "uncertain"]
      },
      "additionalProperties": {"$ref": "#/$defs/assertionScope"}
    },
    "measurement_scope": {"$ref": "#/$defs/measurementScope"},
    "safeguards": {"type": "object"},
    "aggregate_diagnostics": {"type": "object"}
  },
  "additionalProperties": false,
  "$defs": {
    "assertionScope": {
      "type": "object",
      "properties": {
        "before_chars": {"type": "integer", "minimum": 30, "maximum": 300},
        "after_chars": {"type": "integer", "minimum": 20, "maximum": 260},
        "before_gap_chars": {"type": "integer", "minimum": 8, "maximum": 180},
        "after_gap_chars": {"type": "integer", "minimum": 4, "maximum": 120}
      },
      "additionalProperties": false
    },
    "measurementScope": {
      "type": "object",
      "properties": {
        "before_chars": {"type": "integer", "minimum": 20, "maximum": 180},
        "after_chars": {"type": "integer", "minimum": 40, "maximum": 300}
      },
      "additionalProperties": false
    }
  }
}
